EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Pont Clerk -> Firebase Auth.
# Tant que cette variable est VIDE, signInToFirebase() est un no-op : l'app
# n'ouvre aucune session Firebase Auth et depend donc de regles Firestore
# ouvertes. Elle DOIT etre renseignee dans un build installe AVANT tout
# deploiement de firestore.rules, sinon tous les clients passent en
# permission-denied.
# Service verifie le 13/09/2026 : conteneur salorie-firebase-token sur srv3,
# expose par Caddy sur salorie-auth.salorie.com et salorie-auth.salistar.com.
EXPO_PUBLIC_FIREBASE_TOKEN_URL=https://salorie-auth.salorie.com/firebase-token

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend Salorie (sans barre oblique finale : aiProxy concatene `${API_URL}/ai/generate`).
EXPO_PUBLIC_API_URL=https://api.salorie.com

# RevenueCat — cles publiques par plateforme (app.revenuecat.com > API keys).
# Lues par constants/config.ts mais absentes de ce fichier jusqu'au 13/09/2026.
EXPO_PUBLIC_REVENUE_CAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUE_CAT_API_KEY_IOS=
