{
  "expo": {
    "name": "Salorie — Food, Sport & Santé",
    "slug": "salorie",
    "description": "Salorie : ton coach alimentation, sport et santé. Suivi des repas et calories, courses virtuelles avec médailles, séances de sport, TDEE adaptatif, hydratation, sommeil et plus.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salorie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "assetBundlePatterns": [
      "assets/images/**/*",
      "assets/challenges/**/*",
      "assets/data/**/*",
      "assets/models/**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#298f50",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.idriss.kriouile.salorie",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#298f50",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#0f3a22"
          }
        }
      ],
      "expo-secure-store",
      "react-native-health-connect",
      "./plugins/withHealthConnectPermissionDelegate",
      "./plugins/withStepCounterService",
      "./plugins/withNdkVersion",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Salorie uses your location to track your runs (distance, pace, route)."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Salorie uses the camera for the AR challenge experience (point your phone to see landmarks along your route)."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "398124d2-f1df-4613-a1f7-62f2feb0d362"
      }
    }
  }
}
