{
  "name": "salorie",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --variant release",
    "android:dev": "expo run:android",
    "ios": "expo run:ios --configuration Release",
    "ios:dev": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "watch": "powershell -ExecutionPolicy Bypass -File ./watch-and-install.ps1",
    "watch:once": "powershell -ExecutionPolicy Bypass -File ./watch-and-install.ps1 -Once",
    "install:from-github": "powershell -ExecutionPolicy Bypass -File ./install-from-github.ps1",
    "install:from-github:fast": "powershell -ExecutionPolicy Bypass -File ./install-from-github.ps1 -NoLogcat",
    "deploy:phone": "powershell -ExecutionPolicy Bypass -File ./deploy-to-phone.ps1",
    "deploy:phone:fast": "powershell -ExecutionPolicy Bypass -File ./deploy-to-phone.ps1 -SkipBundle",
    "deploy:phone:clean": "powershell -ExecutionPolicy Bypass -File ./deploy-to-phone.ps1 -Clean"
  },
