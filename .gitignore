# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local
!.env.example

# CI/CD watcher state
.gh-watch-state
.gh-artifacts/

# Claude Code worktrees
.claude/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
# android/ EST versionné pour préserver les natifs custom (widget, StepCounterService,
# network_security_config, MainApplication…) — un prebuild les écraserait sinon.
# On ignore uniquement les artefacts de build :
/android/build/
/android/app/build/
/android/.gradle/
/android/.cxx/
/android/app/.cxx/
/android/local.properties
/android/.kotlin/
/android/app/release/

# Firebase CLI debug log
firebase-debug.log
captures-audit/
captures-test-onboarding/
rapports/
*.bak
expo_doctor_report.txt
run_android_log.txt
android/app/src/main/assets/index.android.bundle

# Keystore encodé pour les secrets CI — équivaut au .jks lui-même, ne JAMAIS committer.
*.jks.base64
*.keystore.base64

# Artefacts de Playwright — resultats de la derniere execution, jamais a versionner.
test-results/
web/test-results/
playwright-report/

# Projet natif Android — GENERE par `expo prebuild`, jamais ecrit a la main.
# Le versionner avait deux consequences : la cle API Firebase/Maps injectee par
# app.config.js se retrouvait commitee dans AndroidManifest.xml (depot PUBLIC), et
# chaque `prebuild --clean` produisait un diff enorme ou se cachaient de vraies
# regressions — c'est ainsi qu'un intent-filter Health Connect s'etait duplique 7 fois.
# La CI fait `expo prebuild --platform android --clean` : rien n'est perdu.
# En local, apres un clone : `npx expo prebuild --platform android`.
/android/

# food4k : modeles ONNX hors git (212 Mo > limite GitHub de 100 Mo).
# Publies en asset de Release, recuperes au build (cf. food4k/Dockerfile).
food4k/*.onnx
food4k/*.bak-*
food4k/compare_onnx.py

# Artefacts d audit/tests : images et rapports generes, jamais du code (121 Mo suivis par erreur)
captures-audit/
captures-test-onboarding/
coverage/
rapports/
firestore-debug.log
web/tsconfig.tsbuildinfo
# Videos d exercices : servies par api.salorie.com/videos, plus embarquees depuis registry.ts.
# Les .mp4 locaux ne sont que la source d envoi vers srv3 (76 Mo hors de git).
assets/videos/*.mp4

# Cache Python des scripts utilitaires (scripts/*.py)
__pycache__/
*.pyc

# Profil Edge des campagnes de captures : contient des COOKIES DE SESSION.
# Ne doit jamais entrer dans le depot.
web/profil-captures/

# Corpus de reference IA : ~75 Mo d images, reconstructible par
# scripts/construire-corpus.js. Le manifeste suffit a le reproduire.
corpus-ia/

# Corpus de reference cuisine marocaine/MENA (Wikimedia Commons),
# reconstructible par scripts/construire-corpus-maghreb.js
corpus-maghreb/

# Corpus d entrainement Food-101 (partition train), reconstructible par
# scripts/construire-corpus.js --split train
corpus-entrainement/

# Corpus marocain issu de Hugging Face — LICENCE INCONNUE, cf. le manifeste.
corpus-maghreb-hf/

# ── Corpus et artefacts d'entrainement (septembre 2026) ───────────────────────
# ⚠ 8,3 Go sur 49 000 fichiers. Le depot pese deja 121 Mo ; les y verser le
# rendrait inclonable. Tout est RECONSTRUCTIBLE par la chaine :
#     python food4k/chaine.py
#
# Ce qui reste versionne, et pourquoi : le modele lui-meme
# (food4k/food_salorie.tflite et assets/models/food_salorie.tflite, memes
# octets), ses deux listes d'etiquettes, et les mesures qui ont justifie chaque
# choix (socles.json, resolutions.json). Sans elles, on refait dans six mois les
# comparaisons deja faites — et on les refait peut-etre moins bien.
corpus-maghreb-plus/
corpus-web/

# Le jeu filtre : une COPIE de salorie-entrainement, refaite a chaque
# entrainement par entrainer_modele.py. 33 668 fichiers, 3,7 Go.
food4k/_jeu_filtre/

# Les candidats. Seul celui qui gagne la comparaison est deploye, et c'est
# alors food4k/food_salorie.tflite qui porte le resultat.
food4k/modele_entraine/
food4k/modele_v2/
food4k/modele_v3/
food4k/modele_v*/

# Les sauvegardes ecrites par deployer_modele.py avant chaque bascule. Elles
# servent a revenir en arriere EN LOCAL ; l'historique git fait deja ce travail
# pour le depot, et 6,4 Mo par bascule s'y accumuleraient pour rien.
*.precedent

# Verdicts par image : reecrits a chaque passage des controles, propres a une
# machine et a un instant. Les CONCLUSIONS sont dans les commentaires du code.
**/verdicts-aliment.json
**/coherence.json
food4k/rapport-fuite.json
food4k/comparaison.json
food4k/courbe-confiance.json

# Vidages de pile de Git Bash sous Windows : bruit local, jamais du code.
*.stackdump
