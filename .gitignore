# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local
!.env.example

# CI/CD watcher state
.gh-watch-state
.gh-artifacts/

# Claude Code worktrees
.claude/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
# android/ EST versionné pour préserver les natifs custom (widget, StepCounterService,
# network_security_config, MainApplication…) — un prebuild les écraserait sinon.
# On ignore uniquement les artefacts de build :
/android/build/
/android/app/build/
/android/.gradle/
/android/.cxx/
/android/app/.cxx/
/android/local.properties
/android/.kotlin/
/android/app/release/

# Firebase CLI debug log
firebase-debug.log
captures-audit/
captures-test-onboarding/
rapports/
*.bak
expo_doctor_report.txt
run_android_log.txt
android/app/src/main/assets/index.android.bundle

# Keystore encodé pour les secrets CI — équivaut au .jks lui-même, ne JAMAIS committer.
*.jks.base64
*.keystore.base64
