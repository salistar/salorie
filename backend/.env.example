# Salorie backend env
PORT=4000
MONGO_URI=mongodb://mongo:27017/salorie
REDIS_URL=redis://redis:6379
UPLOAD_DIR=/data/uploads
# Firebase service-account JSON (single line). In prod set via CI secret.
FIREBASE_SERVICE_ACCOUNT=
# MinIO (object storage) — optional, for S3-style file storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=salorie
MINIO_SECRET_KEY=salorie-secret
MINIO_BUCKET=salorie-files
# USDA FoodData Central (generic foods micros) — get a free key at fdc.nal.usda.gov
USDA_API_KEY=DEMO_KEY
# Gemini key for the nightly insights precompute (empty = deterministic offline only)
GEMINI_API_KEY=
GEMINI_LITE_MODEL=gemini-2.0-flash-lite
# Nightly insights precompute cron (default 3am)
INSIGHTS_CRON=0 3 * * *

# Protege les routes admin ET le webhook du pipeline. Obligatoire : sans elle,
# /pipeline/webhook-sink refuse desormais tout appel (echec ferme).
ADMIN_API_KEY=

# ── Strava ────────────────────────────────────────────────────────────────────
# Sans ces trois-la, /strava/etat repond { configure: false } et l'ecran mobile
# affiche « pas encore configure » au lieu d'un bouton qui menerait a une page
# d'erreur Strava. C'est deliberé : mieux vaut ne rien proposer que proposer
# quelque chose de casse.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# DOIT correspondre EXACTEMENT a l'URL de redirection declaree dans les reglages
# de l'application Strava. Un caractere d'ecart et Strava refuse l'echange, avec
# un message qui n'explique rien.
STRAVA_REDIRECT_URI=https://api.salorie.com/strava/retour

# Le secret partage avec Strava pour la validation d'abonnement au webhook.
# A choisir librement, puis a passer a Strava lors de la creation de
# l'abonnement (POST https://www.strava.com/api/v3/push_subscriptions).
#
# ⚠ Sans lui, GET /strava/webhook REFUSE tout : un serveur mal configure doit se
# taire, pas devenir permissif. Repondre au defi « puisqu'il n'y a rien a
# verifier » laisserait n'importe qui faire valider un abonnement a notre place
# et detourner le flux d'evenements.
STRAVA_VERIFY_TOKEN=
