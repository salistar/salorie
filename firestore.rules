rules_version = '2';

// ⚠️ Règles ouvertes (équivalent test-mode) — restaure le fonctionnement de
// l'app qui authentifie via Clerk (pas Firebase Auth), donc Firestore ne voit
// pas request.auth. À durcir plus tard via un bridge Clerk → Firebase custom
// token (template JWT) pour pouvoir conditionner sur request.auth.uid.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
