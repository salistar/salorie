# ---- Clerk → Firebase token endpoint config ----
# Copy to .env (never commit the real values).

# Port the standalone server listens on (standalone-server.mjs only).
PORT=8787

# Clerk JWKS + issuer. Find your Clerk Frontend API domain in the Clerk
# dashboard (it looks like <something>.clerk.accounts.dev for dev instances,
# or your custom domain for production).
CLERK_JWKS_URL=https://evident-drake-70.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://evident-drake-70.clerk.accounts.dev

# Clerk Backend API secret key (sk_test_... in dev, sk_live_... in prod).
# Used to read the user's primary email server-side.
CLERK_SECRET_KEY=sk_test_xxx

# Firebase service-account JSON, stringified onto ONE line.
# Get it: Firebase console → Project settings → Service accounts →
#         Generate new private key → open the JSON → paste it all here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"salistar-salorie","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@salistar-salorie.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
