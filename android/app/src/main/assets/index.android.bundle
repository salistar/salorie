0645 \u062a\u062c\u0647\u064a\u0632 \u062e\u0637\u062a\u0643\u2026','mealplan.error':'\u062a\u0639\u0630\u0651\u0631 \u0625\u0646\u0634\u0627\u0621 \u062e\u0637\u0629. \u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062a\u0635\u0627\u0644\u0643 \u0648\u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629.','mealplan.retry':'\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629','mealplan.log':'\u062a\u0633\u062c\u064a\u0644','mealplan.daily_total':'\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u064a\u0648\u0645','mealplan.micros':'\u0627\u0644\u0645\u063a\u0630\u064a\u0627\u062a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 (\u062a\u0642\u062f\u064a\u0631 % \u0645\u0646 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u062c \u0627\u0644\u064a\u0648\u0645\u064a)','mealplan.regenerate':'\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u0644\u064a\u062f','nutrients.title':'\u0645\u063a\u0630\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645','nutrients.subtitle':'\u0645\u063a\u0630\u064a\u0627\u062a \u062f\u0642\u064a\u0642\u0629 \u0645\u064f\u0642\u062f\u064e\u0651\u0631\u0629 \u0645\u0645\u0627 \u0633\u062c\u0651\u0644\u062a\u0647 \u0641\u0639\u0644\u064a\u064b\u0627 \u0627\u0644\u064a\u0648\u0645.','nutrients.analyzing':'\u064a\u062a\u0645 \u062a\u062d\u0644\u064a\u0644 \u0648\u062c\u0628\u0627\u062a\u0643\u2026','nutrients.empty_title':'\u0644\u0627 \u0648\u062c\u0628\u0627\u062a \u0645\u0633\u062c\u0651\u0644\u0629 \u0627\u0644\u064a\u0648\u0645','nutrients.empty_sub':'\u0633\u062c\u0651\u0644 \u0648\u062c\u0628\u0629 \u0648\u0639\u064f\u062f \u0644\u0631\u0624\u064a\u0629 \u062a\u063a\u0637\u064a\u062a\u0643 \u0645\u0646 \u0627\u0644\u0641\u064a\u062a\u0627\u0645\u064a\u0646\u0627\u062a \u0648\u0627\u0644\u0645\u0639\u0627\u062f\u0646.','nutrients.log_food':'\u062a\u0633\u062c\u064a\u0644 \u0637\u0639\u0627\u0645','nutrients.error':'\u062a\u0639\u0630\u0651\u0631 \u062a\u0642\u062f\u064a\u0631 \u0627\u0644\u0645\u063a\u0630\u