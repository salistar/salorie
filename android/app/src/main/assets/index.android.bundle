\u0647\u0630\u0627 \u0628\u0631\u064a\u062f\u0643 \u0623\u0646\u062a.','social.error':'\u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u0627. \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629.','coach.health_title':'\u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0635\u062d\u0629','coach.health_sub':'\u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0648\u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0645\u0646 Google Health','health.title':'\u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0635\u062d\u0629','health.subtitle':'\u0627\u0633\u062a\u0648\u0631\u062f \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0648\u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0627\u0644\u0646\u0634\u0637\u0629 \u0648\u0627\u0644\u0648\u0632\u0646 \u0645\u0646 Google Health Connect.','health.connect':'\u0631\u0628\u0637 Health Connect','health.unavailable':'Health Connect \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632.','health.steps':'\u0627\u0644\u062e\u0637\u0648\u0627\u062a','health.active_kcal':'\u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0627\u0644\u0646\u0634\u0637\u0629','health.weight':'\u0627\u0644\u0648\u0632\u0646','health.refresh':'\u062a\u062d\u062f\u064a\u062b','health.log_activity':'\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0627\u0644\u0646\u0634\u0637\u0629 \u0643\u0646\u0634\u0627\u0637','health.no_data':'\u0644\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0644\u0644\u064a\u0648\u0645 \u0628\u0639\u062f. \u062a\u062d\u0631\u0651\u0643 \u062b\u0645 \u062d\u062f\u0651\u062b.','health.connected':'\u0645\u062a\u0635\u0644 \u2713','health.logged':'\u0623\u064f\u0636\u064a\u0641 \u0625\u0644\u0649 \u0627\u0644\u064a\u0648\u0645 \u2713'}},w=s(void 0);function k(){}e.I18nProvider=function(l){var s,c,v,C=n(12),x=l.children,A=h("en"),S=o(A,2),P=S[0],j=S[1];C[0]===Symbol.for("react.memo_cache_sentinel")?(s=()=>{try{_.isRTL&&(_.allowRTL(!1),_.forceRTL(!1))}cat