0644\u0628\u0627\u0631 \u0639\u0644\u0649 \u0627\u0644\u062a\u0631\u0627\u0628\u0633 \u0627\u0644\u0639\u0644\u0648\u064a\u0629\u060c \u0627\u0644\u0642\u062f\u0645\u0627\u0646 \u0628\u0639\u0631\u0636 \u0627\u0644\u0643\u062a\u0641\u064a\u0646. \u0627\u0646\u0632\u0644 \u0628\u0627\u0644\u0648\u0631\u0643\u064a\u0646 \u0625\u0644\u0649 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0641\u062e\u0630\u0627\u0646 \u0645\u0648\u0627\u0632\u064a\u062a\u064a\u0646 \u0644\u0644\u0623\u0631\u0636. \u0627\u062f\u0641\u0639 \u0645\u0646 \u0627\u0644\u0643\u0639\u0628\u064a\u0646\u060c \u0648\u0627\u0644\u0635\u062f\u0631 \u0645\u0631\u0641\u0648\u0639.','lift.howto.deadlift':'\u0627\u0644\u0628\u0627\u0631 \u0641\u0648\u0642 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0642\u062f\u0645\u060c \u0627\u0646\u062d\u0646\u0627\u0621 \u0627\u0644\u0648\u0631\u0643\u064a\u0646 \u0644\u0644\u0625\u0645\u0633\u0627\u0643 \u0628\u0627\u0644\u0628\u0627\u0631\u060c \u0634\u062f \u0627\u0644\u062c\u0630\u0639 \u0628\u0642\u0648\u0629. \u0627\u0646\u0647\u0636 \u0628\u062f\u0641\u0639 \u0627\u0644\u0623\u0631\u0636\u060c \u0648\u0627\u0628\u0642\u0650 \u0627\u0644\u0628\u0627\u0631 \u0642\u0631\u064a\u0628\u0627\u064b \u0645\u0646 \u0627\u0644\u062c\u0633\u0645.','lift.howto.shoulder_press':'\u062c\u0627\u0644\u0633\u0627\u064b \u0623\u0648 \u0648\u0627\u0642\u0641\u0627\u064b\u060c \u0627\u062f\u0641\u0639 \u0627\u0644\u0628\u0627\u0631 \u0623\u0648 \u0627\u0644\u062f\u0645\u0628\u0644\u0632 \u0641\u0648\u0642 \u0627\u0644\u0631\u0623\u0633. \u062a\u0648\u0642\u0641 \u0642\u0628\u0644 \u0627\u0644\u0642\u0641\u0644 \u0627\u0644\u0643\u0627\u0645\u0644. \u0627\u0644\u0623\u0636\u0644\u0627\u0639 \u0644\u0644\u0623\u0633\u0641\u0644\u060c \u0648\u0644\u0627 \u062a\u0642\u0648\u0633 \u0627\u0644\u0638\u0647\u0631.','lift.howto.pullup':'\u0639\u0644\u0651\u0642 \u0645\u0646 \u0627\u0644\u0628\u0627\u0631 \u0628\u0642\u0628\u0636\u0629 \u0648\u0627\u0633\u0639\u0629. \u0627\u0633\u062d\u0628 \u0627\u0644\u0635\u062f\u0631 \u0646\u062d\u0648 \u0627\u0644\u0628\u0627\u0631\u060c \u0648\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u0646 \u0644\u0644\u0623\u0633\u0641\u0644. \u0646\u0632\u0648\u0644 \u0645\u062a\u062d\u0643\u0645 \u062f\u0648\u0646 \u062a\u0623\u0631\u062c\u062d.','lift.howto.bicep_curl':'\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u0646 \u0645\u0644\u062a\u0635\u0642\u0627\u0646 \u0628\u0627\u0644\u062c\u0633\u0645\u060c \u0627\u0631\u0641\u0639 \u0627\u0644\u0648\u0632\u0646 \u0628\u062b\u0646\u064a \u0627\u0644\u0639\u0636\u0644\u0629 \u0630\u0627\u062a \u0627\u0644\u0631\u0623\u0633\u064a\u0646. \u0627\u0639\u0635\u0631 \u0641\u064a \u0627\u0644\u0623\u0639\u0644\u0649\u060c \u0648\u0646\u0632\u0648\u0644 \u0628\u0637\u064a\u0621.','lift.howto.incline_bench':'\u0627\u0644\u0645\u0642\u0639\u062f \u0628\u0632\u0627\u0648\u064a\u0629 30-45\xb0. \u0646\u0641\u0633 \u062a\u0642\u0646\u064a\u0629 \u0627\u0644\u0628\u0646\u0634 \u0627\u0644\u0623\u0641\u0642\u064a \u2014 \u064a\u0633\u062a\u0647\u062f\u0641 \u0623\u0639\u0644\u0649 \u0627\u0644\u0635\u062f\u0631 \u0648\u0627\u0644\u062f\u0627\u0644\u064a\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629.','lift.howto.dumbbell_row':'\u0627\u0644\u064a\u062f \u0648\u0627\u0644\u0631\u0643\u0628\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u0639\u062f\u060c \u0627\u0646\u062d\u0646\u0627\u0621 \u0627\u0644\u0648\u0631\u0643\u064a\u0646. \u0627\u0633\u062d\u0628 \u0627\u0644\u062f\u0645\u0628\u0644 \u0646\u062d\u0648 \u0627\u0644\u062d\u0648\u0636 \u0645\u0639 \u0639\u0635\u0631 \u0644\u0648\u062d \u0627\u0644\u0643\u062a\u0641. \u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0646\u0632\u0648\u0644.','lift.howto.barbell_row':'\u0627\u0644\u062c\u0630\u0639 \u0645\u0646\u062d\u0646\u064d \u0628\u0632\u0627\u0648\u064a\u0629 45\xb0 \u062a\u0642\u0631\u064a\u0628\u0627\u064b\u060c \u0627\u0633\u062d\u0628 \u0627\u0644\u0628\u0627\u0631 \u0625\u0644\u0649 \u0623\u0633\u0641\u0644 \u0627\u0644\u0635\u062f\u0631. \u0627\u0644\u0645\u0631\u0641\u0642\u0627\u0646 \u0642\u0631\u064a\u0628\u0627\u0646 \u0645\u0646 \u0627\u0644\u062c\u0633\u0645\u060c \u0627\u0644\u0638\u0647\u0631 \u0645\u0633\u062a\u0642\u064a\u0645.','lift.howto.lat_pulldown':'\u0642\u0628\u0636\u0629 \u0648\u0627\u0633\u0639\u0629\u060c \u0627\u0633\u062d\u0628 \u0627\u0644\u0628\u0627\u0631 \u0625\u0644\u0649 \u0623\u0639\u0644\u0649 \u0627\u0644\u0635\u062f\u0631\u060c \u0627\u0644\u0645\u0631\u0641\u0642\u0627\u0646 \u0644\u0644\u0623\u0633\u0641\u0644 \u0648\u0627\u0644\u062e\u0644\u0641. \u0627\u0639\u0635\u0631 \u0627\u0644\u0639\u0636\u0644\u0627\u062a \u0627\u0644\u0638\u0647\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0623\u0633\u0641\u0644.','lift.howto.leg_press':'\u0627\u0644\u0642\u062f\u0645\u0627\u0646 \u0628\u0639\u0631\u0636 \u0627\u0644\u0643\u062a\u0641\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0635\u0629. \u0627\u0646\u0632\u0644 \u062d\u062a\u0649 \u062a\u0635\u0644 \u0627\u0644\u0631\u0643\u0628\u062a\u0627\u0646 \u0625\u0644\u0649 90\xb0\u060c \u062b\u0645 \u0627\u062f\u0641\u0639 \u062f\u0648\u0646 \u0642\u0641\u0644 \u0627\u0644\u0631\u0643\u0628\u062a\u064a\u0646.','lift.howto.lunges':'\u062e\u0637\u0648\u0629 \u0644\u0644\u0623\u0645\u0627\u0645\u060c \u0627\u0644\u0631\u0643\u0628\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0642\u0631\u064a\u0628\u0629 \u0645\u0646 \u0627\u0644\u0623\u0631\u0636. \u0627\u0644\u0631\u0643\u0628\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0641\u0648\u0642 \u0627\u0644\u0643\u0627\u062d\u0644. \u0627\u062f\u0641\u0639 \u0645\u0646 \u0627\u0644\u0643\u0639\u0628 \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0644\u0644\u0639\u0648\u062f\u0629.','lift.howto.romanian_dl':'\u0627\u0644\u0631\u0643\u0628\u062a\u0627\u0646 \u0645\u0631\u062a\u062e\u064a\u062a\u0627\u0646\u060c \u0627\u0646\u062d\u0646\u0627\u0621 \u0627\u0644\u0648\u0631\u0643\u064a\u0646 \u0648\u0627\u0644\u0628\u0627\u0631 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0627\u0644\u0633\u0627\u0642\u064a\u0646. \u0627\u0646\u0632\u0644 \u0625\u0644\u0649 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0633\u0627\u0642\u060c \u0627\u0633\u062a\u0634\u0639\u0631 \u0634\u062f \u0627\u0644\u0623\u0648\u062a\u0627\u0631.','lift.howto.tricep_dips':'\u0639\u0644\u0649 \u0627\u0644\u0642\u0636\u0628\u0627\u0646 \u0627\u0644\u0645\u062a\u0648\u0627\u0632\u064a\u0629\u060c \u0627\u0646\u0632\u0644 \u062d\u062a\u0649 90\xb0 \u0641\u064a \u0627\u0644\u0645\u0631\u0641\u0642\u064a\u0646. \u0627\u062f\u0641\u0639 \u0644\u0644\u0623\u0639\u0644\u0649 \u0628\u0645\u062f \u0627\u0644\u062a\u0631\u0627\u064a\u0633\u0628\u0633. \u0627\u0644\u062c\u0630\u0639 \u0645\u0633\u062a\u0642\u064a\u0645 \u0644\u0644\u062a\u0631\u0627\u064a\u0633\u0628\u0633.','lift.howto.tricep_pushdown':'\u0627\u0644\u0628\u0643\u0631\u0629 \u0627\u0644\u0639\u0644\u0648\u064a\u0629\u060c \u0627\u0644\u0645\u0631\u0641\u0642\u0627\u0646 \u0645\u0644\u062a\u0635\u0642\u0627\u0646 \u0628\u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0646. \u0645\u062f\u0651 \u0627\u0644\u0630\u0631\u0627\u0639\u064a\u0646 \u0643\u0627\u0645\u0644\u0627\u064b\u060c \u0627\u0639\u0635\u0631 \u0627\u0644\u062a\u0631\u0627\u064a\u0633\u0628\u0633\u060c \u0639\u0648\u062f\u0629 \u0628\u0637\u064a\u0626\u0629.','lift.howto.hammer_curl':'\u0642\u0628\u0636\u0629 \u0645\u062d\u0627\u064a\u062f\u0629 (\u0627\u0644\u0631\u0627\u062d\u062a\u0627\u0646 \u0645\u062a\u0642\u0627\u0628\u0644\u062a\u0627\u0646)\u060c \u0627\u0631\u0641\u0639 \u0627\u0644\u062f\u0645\u0628\u0644\u0632. \u064a\u0633\u062a\u0647\u062f\u0641 \u0627\u0644\u0639\u0636\u0644\u0629 \u0627\u0644\u0639\u0636\u062f\u064a\u0629 \u0648\u0627\u0644\u0633\u0627\u0639\u062f \u0628\u062c\u0627\u0646\u0628 \u0627\u0644\u0628\u0627\u064a\u0633\u0628\u0633.','lift.howto.preacher_curl':'\u0627\u0644\u0630\u0631\u0627\u0639 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0648\u0633\u0627\u062f\u0629. \u0627\u0631\u0641\u0639 \u0627\u0644\u0628\u0627\u0631 \u0628\u0634\u0643\u0644 \u0635\u0627\u0631\u0645\u060c \u062e\u0627\u0635\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0646\u0632\u0648\u0644. \u0644\u0627 \u0627\u0631\u062a\u062f\u0627\u062f.','lift.howto.lateral_raise':'\u062b\u0646\u064a\u0629 \u062e\u0641\u064a\u0641\u0629 \u0641\u064a \u0627\u0644\u0645\u0631\u0641\u0642\u064a\u0646. \u0627\u0631\u0641\u0639 \u0627\u0644\u062f\u0645\u0628\u0644\u0632 \u0625\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0643\u062a\u0641\u060c \u0627\u0644\u062e\u0646\u0635\u0631 \u0645\u0631\u0641\u0648\u0639 \u0642\u0644\u064a\u0644\u0627\u064b. \u062f\u0648\u0646 \u0627\u0646\u062f\u0641\u0627\u0639.','lift.howto.front_raise':'\u0627\u0631\u0641\u0639 \u0627\u0644\u062f\u0645\u0628\u0644 \u0623\u0645\u0627\u0645\u0643 \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0643\u062a\u0641. \u0646\u0632\u0648\u0644 \u0628\u0637\u064a\u0621. \u0628\u0627\u0644\u062a\u0646\u0627\u0648\u0628 \u0623\u0648 \u0645\u0639\u0627\u064b.','lift.howto.face_pull':'\u062d\u0628\u0644 \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0648\u062c\u0647. \u0627\u0633\u062d\u0628 \u0646\u062d\u0648 \u0627\u0644\u0648\u062c\u0647\u060c \u0627\u0644\u0645\u0631\u0641\u0642\u0627\u0646 \u0639\u0627\u0644\u064a\u0627\u0646 \u0648\u0648\u0627\u0633\u0639\u0627\u0646. \u0645\u0645\u062a\u0627\u0632 \u0644\u0644\u062f\u0627\u0644\u064a\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629.','lift.howto.chest_fly':'\u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u0639\u062f\u060c \u062b\u0646\u064a\u0629 \u062e\u0641\u064a\u0641\u0629 \u0648\u0645\u062b\u0628\u062a\u0629 \u0641\u064a \u0627\u0644\u0645\u0631\u0641\u0642\u064a\u0646. \u0627\u0641\u062a\u062d \u0627\u0644\u062f\u0645\u0628\u0644\u0632 \u0628\u0642\u0648\u0633\u060c \u062b\u0645 \u0627\u0639\u0635\u0631\u0647\u0645\u0627 \u0645\u0639\u0627\u064b \u0641\u0648\u0642 \u0627\u0644\u0635\u062f\u0631.','lift.howto.cable_crossover':'\u0642\u0641 \u0628\u064a\u0646 \u0627\u0644\u0628\u0643\u0631\u0627\u062a\u060c \u0645\u064a\u0644\u0627\u0646 \u0623\u0645\u0627\u0645\u064a \u062e\u0641\u064a\u0641. \u0642\u0631\u0651\u0628 \u0627\u0644\u064a\u062f\u064a\u0646 \u0623\u0645\u0627\u0645 \u0627\u0644\u0635\u062f\u0631\u060c \u0627\u0639\u0635\u0631 \u0628\u0642\u0648\u0629.','lift.howto.calf_raise':'\u0642\u0641 \u0639\u0644\u0649 \u062f\u0631\u062c\u0629\u060c \u0627\u0631\u062a\u0641\u0639 \u0639\u0644\u0649 \u0623\u0637\u0631\u0627\u0641 \u0627\u0644\u0623\u0635\u0627\u0628\u0639\u060c \u0634\u062f \u0643\u0627\u0645\u0644 \u0641\u064a \u0627\u0644\u0623\u0633\u0641\u0644\u060c \u0627\u0646\u0642\u0628\u0627\u0636 \u0641\u064a \u0627\u0644\u0623\u0639\u0644\u0649.','lift.howto.leg_curl':'\u062c\u0647\u0627\u0632 \u0645\u0633\u062a\u0644\u0642\u064d \u0623\u0648 \u062c\u0627\u0644\u0633. \u0627\u062b\u0646\u0650 \u0627\u0644\u0643\u0639\u0628\u064a\u0646 \u0646\u062d\u0648 \u0627\u0644\u0623\u0644\u0648\u064a\u0629\u060c \u0627\u0639\u0635\u0631 \u0627\u0644\u0623\u0648\u062a\u0627\u0631. \u0646\u0632\u0648\u0644 \u0628\u0637\u064a\u0621.','lift.howto.leg_extension':'\u062c\u0627\u0644\u0633\u0627\u064b\u060c \u0645\u062f\u0651 \u0627\u0644\u0631\u0643\u0628\u062a\u064a\u0646 \u0643\u0627\u0645\u0644\u0627\u064b. \u062a\u0648\u0642\u0641 \u0644\u062b\u0627\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0623\u0639\u0644\u0649\u060c \u0646\u0632\u0648\u0644 \u0628\u0637\u064a\u0621. \u064a\u0633\u062a\u0647\u062f\u0641 \u0627\u0644\u0631\u0628\u0627\u0639\u064a\u0629.','lift.howto.hip_thrust':'\u0623\u0639\u0644\u0649 \u0627\u0644\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u0639\u062f\u060c \u0627\u0644\u0628\u0627\u0631 \u0641\u0648\u0642 \u0627\u0644\u0648\u0631\u0643\u064a\u0646. \u0627\u062f\u0641\u0639 \u0627\u0644\u0648\u0631\u0643\u064a\u0646 \u0644\u0644\u0623\u0639\u0644\u0649\u060c \u0627\u0639\u0635\u0631 \u0627\u0644\u0623\u0644\u0648\u064a\u0629 \u0628\u0642\u0648\u0629. \u0627\u0644\u0630\u0642\u0646 \u0644\u0644\u062f\u0627\u062e\u0644.','lift.howto.bulgarian_split':'\u0627\u0644\u0642\u062f\u0645 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0645\u0631\u0641\u0648\u0639\u0629 \u0639\u0644\u0649 \u0645\u0642\u0639\u062f. \u0627\u0646\u0632\u0644 \u0641\u064a \u0627\u0646\u062f\u0641\u0627\u0639 \u0639\u0645\u064a\u0642 \u0639\u0644\u0649 \u0627\u0644\u0633\u0627\u0642 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629. \u0627\u0644\u062c\u0630\u0639 \u0645\u0633\u062a\u0642\u064a\u0645.','lift.howto.plank':'\u0627\u0644\u0633\u0627\u0639\u062f\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636\u060c \u0627\u0644\u062c\u0633\u0645 \u0645\u0633\u062a\u0642\u064a\u0645 \u0645\u0646 \u0627\u0644\u0631\u0623\u0633 \u0644\u0644\u0643\u0639\u0628\u064a\u0646. \u0634\u062f \u0627\u0644\u0628\u0637\u0646 \u0648\u0627\u0644\u0623\u0644\u0648\u064a\u0629. \u062a\u0646\u0641\u0633.','lift.howto.crunches':'\u0627\u0633\u062a\u0644\u0642\u0650 \u0639\u0644\u0649 \u0638\u0647\u0631\u0643\u060c \u0627\u0644\u0642\u062f\u0645\u0627\u0646 \u0645\u0633\u0637\u062d\u062a\u0627\u0646. \u0627\u0631\u0641\u0639 \u0644\u0648\u062d\u064a \u0627\u0644\u0643\u062a\u0641 (\u0644\u064a\u0633 \u062c\u0644\u0648\u0633 \u0643\u0627\u0645\u0644). \u0627\u0632\u0641\u0631 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0627\u0646\u0642\u0628\u0627\u0636.','lift.howto.russian_twist':'\u062c\u0627\u0644\u0633\u0627\u064b\u060c \u0645\u064a\u0644\u0627\u0646 \u0644\u0644\u062e\u0644\u0641 45\xb0\u060c \u0627\u0644\u0642\u062f\u0645\u0627\u0646 \u0645\u0631\u0641\u0648\u0639\u062a\u0627\u0646. \u0627\u0644\u062a\u0641\u0651 \u064a\u0645\u064a\u0646\u0627\u064b \u0648\u064a\u0633\u0627\u0631\u0627\u064b \u0645\u0644\u0627\u0645\u0633\u0627\u064b \u0627\u0644\u0623\u0631\u0636.','lift.howto.hanging_knee':'\u0639\u0644\u0651\u0642 \u0645\u0646 \u0628\u0627\u0631 \u0627\u0644\u0633\u062d\u0628. \u0627\u0631\u0641\u0639 \u0627\u0644\u0631\u0643\u0628\u062a\u064a\u0646 \u0646\u062d\u0648 \u0627\u0644\u0635\u062f\u0631. \u0646\u0632\u0648\u0644 \u0645\u062a\u062d\u0643\u0645\u060c \u062f\u0648\u0646 \u062a\u0623\u0631\u062c\u062d.','result.burned':'\u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0648\u0642\u0629','result.log_workout':'\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062a\u0645\u0631\u064a\u0646','manual.title':'\u0625\u062f\u062e\u0627\u0644 \u064a\u062f\u0648\u064a','manual.subtitle':'\u0633\u062c\u0644 \u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0648\u0642\u0629 \u0644\u0623\u064a \u0646\u0634\u0627\u0637.','manual.what_did':'\u0645\u0627 \u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0630\u064a \u0642\u0645\u062a \u0628\u0647\u061f','manual.activity_ph':'\u0645\u062b\u0627\u0644: \u0633\u0628\u0627\u062d\u0629\u060c \u0645\u0644\u0627\u0643\u0645\u0629...','manual.calories_burned':'\u0627\u0644\u0633\u0639\u0631\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0648\u0642\u0629','manual.log_activity':'\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0646\u0634\u0627\u0637','fooddb.title':'\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0623\u0637\u0639\u0645\u0629','fooddb.search_ph':'\u0628\u062d\u062b (\u0645\u062b\u0627\u0644: \u062a\u0641\u0627\u062d\u060c \u062f\u062c\u0627\u062c...)','fooddb.no_results':'\u0644\u0627 \u062a\u0648\u062c\u062f \u0646\u062a\u0627\u0626\u062c \u0644\u0640','fooddb.keep_typing':'\u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u0629...','logfood.title':'\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0637\u0639\u0627\u0645','logfood.food_name':'\u0627\u0633\u0645 \u0627\u0644\u0637\u0639\u0627\u0645','logfood.food_name_ph':'\u0627\u0633\u0645 \u0637\u0639\u0627\u0645\u0643...','logfood.unit_ph':'\u0627\u0644\u0648\u062d\u062f\u0629 (\u0645\u062b\u0644 g\u060c ml\u060c \u0643\u0648\u0628)','logfood.calories':'\u0627\u0644\u0633\u0639\u0631\u0627\u062