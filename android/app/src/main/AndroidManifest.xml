        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="salorie"/>
        <data android:scheme="com.idriss.kriouile.salorie"/>
        <data android:scheme="exp+salorie"/>
      </intent-filter>
      <!-- App Links VÉRIFIÉ (fix définitif OAuth Google) : le redirect HTTPS ouvre l'app
