  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- WRITE_EXTERNAL_STORAGE limité aux vieux Android (≤28) ; sur 33+ on lit via READ_MEDIA_IMAGES et on écrit en scoped storage (MediaLibrary). -->
