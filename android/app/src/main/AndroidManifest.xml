  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <!-- SYSTEM_ALERT_WINDOW retiré : non utilisé (aucun overlay draw-over-apps) + red flag Play. tools:node=remove le strippe même si une lib le fusionne. -->
